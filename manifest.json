{
  "manifest_version": 3,
  "name": "syncme",
  "version": "1.0.0",
  "description": "copy your logins for a site into a separate chrome that your ai agents and scripts can use",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": "",
  "permissions": [
    "alarms",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "approve.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "approve.html"
}
