{
  "manifest_version": 3,
  "name": "syncme",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "approve.html"
  },
  "options_page": "approve.html"
}
